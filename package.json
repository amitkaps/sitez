{
  "name": "@amitkaps/sitez",
  "version": "0.3.0",
  "description": "A zero-config static site generator: Markz in text/, JavaScript in code/, JSON in data/, files in public/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/sitez.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/elementz/index.d.ts",
      "default": "./dist/elementz/index.js"
    },
    "./vite": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "fix": "vp check --fix",
    "prepack": "vp pack",
    "prose": "prose",
    "test": "vp test --run",
    "verify": "pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@amitkaps/markz": "^0.4.0"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.4.0",
    "@types/node": "^24.0.0",
    "happy-dom": "20.14.5",
    "typescript": "^7.0.2",
    "vite-plus": "1.1.0"
  },
  "peerDependencies": {
    "vite-plus": "^1.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
