{
  "name": "@amitkaps/sitez",
  "version": "0.2.0",
  "description": "A zero-config static site generator: Markz in text/, JavaScript in code/, JSON in data/, files in public/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/sitez.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepack": "vp pack",
    "prose": "prose",
    "test": "vp test --run"
  },
  "dependencies": {
    "@amitkaps/markz": "^0.2.0"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.3.0",
    "@types/node": "^24.0.0",
    "happy-dom": "20.14.5",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.0"
}
