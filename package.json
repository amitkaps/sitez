{
  "name": "sitez",
  "version": "0.1.0",
  "description": "A zero-config static site generator: Markz in text/, JavaScript in code/, files in public/.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amitkaps/sitez.git"
  },
  "bin": {
    "sitez": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/runtime/browser.d.ts",
        "default": "./dist/runtime/browser.js"
      },
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "dev": "vp pack --watch",
    "prepack": "vp pack",
    "prose": "prose",
    "sitez": "node src/cli.ts",
    "test": "vp test --run"
  },
  "dependencies": {
    "@amitkaps/markz": "^0.2.0",
    "@preact/signals-core": "^1.14.4",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "devalue": "^6.0.2",
    "htl": "^1.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vite-plus": "1.0.0"
  },
  "devDependencies": {
    "@amitkaps/prose": "^0.3.0",
    "@types/node": "^24.0.0",
    "happy-dom": "20.14.5",
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.8.1",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1"
}
