{
	"name": "sitez",
	"version": "0.0.0",
	"description": "A zero-config static site generator: Markz in prose/, Svelte in pattern/, files in public/.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/amitkaps/sitez.git"
	},
	"bin": {
		"sitez": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"scripts": {
		"build": "vp pack",
		"check": "vp check",
		"dev": "vp pack --watch",
		"prepack": "vp pack",
		"sitez": "node src/cli.ts",
		"test": "vp test --run"
	},
	"dependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"devalue": "^6.0.2",
		"markz": "https://github.com/amitkaps/markz/releases/download/v0.1.0/markz-0.1.0.tgz",
		"svelte": "^5.57.1",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.0.0"
	},
	"devDependencies": {
		"@amitkaps/prose": "https://github.com/amitkaps/prose/releases/download/v0.1.0/amitkaps-prose-0.1.0.tgz",
		"@happy-dom/global-registrator": "^20.14.5",
		"@types/node": "^26.0.0",
		"typescript": "^6.0.3",
		"vite-plus": "1.0.0"
	},
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.6.0"
}
